<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_exercise"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_reps_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Повторения:"
        android:layout_marginTop="16dp"/>

    <SeekBar
        android:id="@+id/sb_reps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="50"/>

    <TextView
        android:id="@+id/tv_reps_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textAlignment="center"/>

    <TextView
        android:id="@+id/tv_sets_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Подходы:"
        android:layout_marginTop="16dp"/>

    <SeekBar
        android:id="@+id/sb_sets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"/>

    <TextView
        android:id="@+id/tv_sets_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textAlignment="center"/>

    <Button
        android:id="@+id/btn_add_to_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить в план"
        android:layout_marginTop="24dp"/>

</LinearLayout>